{
  "name": "@gps/web-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": {
      "@gps/source": "./src/styles/globals.css",
      "style": "./src/styles/globals.css",
      "default": "./src/styles/globals.css"
    },
    "./lib/utils": {
      "@gps/source": "./src/lib/utils.ts"
    },
    "./components/ui/*": {
      "@gps/source": "./src/components/ui/*"
    },
    ".": {
      "@gps/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:web",
      "type:ui"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "input-otp": "1.4.1",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.13.2",
    "react-resizable-panels": "^2.1.9",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "shadcn": "^3.8.5"
  }
}
