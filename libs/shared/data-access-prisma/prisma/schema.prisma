}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskType {
  MANUAL
  APPROVAL
  DOCUMENT_REVIEW
  FOLLOW_UP
  IMPORT
  OTHER
}

enum ApprovalStatus {
  REQUESTED
  IN_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  CHANGES_REQUESTED
