generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LEFT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE_GATEWAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum FeeBillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum FeeAdjustmentType {
  CHARGE
  DISCOUNT
}

enum FamilyBenefitType {
  PERCENTAGE
  FIXED
  WAIVER
}

enum InvoiceDeliveryChannel {
  EMAIL
  PORTAL
  PRINT
}

enum InvoiceDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum TransportAssignmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DocumentEntityType {
  STUDENT
  GUARDIAN
  STAFF
  TEACHER
  SCHOOL
  VEHICLE
  INVOICE
  PAYMENT
  OTHER
