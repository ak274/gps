model ApprovalStep {
  id                String             @id @default(cuid())
  approvalRequestId String             @map("approval_request_id")
  sequence          Int
  assigneeId        String             @map("assignee_id")
  status            ApprovalStepStatus @default(PENDING)
  decisionNote      String?            @map("decision_note")
  decidedAt         DateTime?          @map("decided_at")
  decidedById       String?            @map("decided_by_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  assignee        User            @relation("ApprovalStepAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  decidedBy       User?           @relation("ApprovalStepDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([approvalRequestId, sequence], map: "uq_approval_steps_request_sequence")
  @@index([assigneeId, status], map: "idx_approval_steps_assignee_status")
  @@map("approval_steps")
}

