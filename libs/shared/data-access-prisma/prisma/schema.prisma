}

enum ExamStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  INFO_REQUESTED
  APPROVED
  WAITLISTED
  REJECTED
  OFFERED
  FEE_PENDING
  READY_FOR_ENROLLMENT
  ENROLLED
  WITHDRAWN
}

enum AdmissionEventType {
  CREATED
  UPDATED
  SUBMITTED
  REVIEW_STARTED
  INFO_REQUESTED
  INFO_RECEIVED
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  ASSESSMENT_RECORDED
  APPROVED
  WAITLISTED
  REJECTED
  OFFERED
  FEE_MARKED_PAID
  FINAL_VERIFIED
  ENROLLED
  NOTE_ADDED
}

enum AdmissionDocumentReviewStatus {
  PENDING
  VERIFIED
  REJECTED
