model Task {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  schoolId      String       @map("school_id")
  title         String
  description   String?
  type          TaskType     @default(MANUAL)
  status        TaskStatus   @default(OPEN)
  priority      TaskPriority @default(NORMAL)
  assigneeId    String?      @map("assignee_id")
  createdById   String       @map("created_by_id")
  completedById String?      @map("completed_by_id")
  sourceType    String?      @map("source_type")
  sourceId      String?      @map("source_id")
  actionUrl     String?      @map("action_url")
  dueAt         DateTime?    @map("due_at")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  tenant      Tenant         @relation("TenantTasks", fields: [tenantId], references: [id], onDelete: Cascade)
  school      School         @relation("SchoolTasks", fields: [schoolId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?          @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  reminders   TaskReminder[]

  @@index([tenantId, schoolId, status, dueAt], map: "idx_tasks_school_status_due")
  @@index([tenantId, assigneeId, status, dueAt], map: "idx_tasks_assignee_status_due")
  @@index([sourceType, sourceId], map: "idx_tasks_source")
  @@map("tasks")
}

model TaskReminder {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  remindAt  DateTime  @map("remind_at")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation("TenantTaskReminders", fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation("TaskReminderUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, sentAt, remindAt], map: "idx_task_reminders_due")
  @@map("task_reminders")
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  schoolId      String         @map("school_id")
  title         String
  description   String?
  status        ApprovalStatus @default(REQUESTED)
  entityType    String         @map("entity_type")
  entityId      String         @map("entity_id")
  requestedById String         @map("requested_by_id")
  dueAt         DateTime?      @map("due_at")
  completedAt   DateTime?      @map("completed_at")
