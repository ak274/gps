}

enum StudentDocumentStatus {
  REQUIRED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  NOT_APPLICABLE
}

enum AdmissionFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AdmissionFieldType {
  TEXT
  TEXTAREA
  DATE
  NUMBER
  PHONE
  EMAIL
  SELECT
  MULTI_SELECT
  BOOLEAN
  FILE
}

enum AdmissionDocumentStage {
  APPLICATION
  REVIEW
  ENROLLMENT
}

enum AdmissionLeadStatus {
  STARTED
  VERIFIED
  SUBMITTED
  EXPIRED
}

enum PromotionBatchStatus {
  DRAFT
  APPLIED
  CANCELLED
}

enum PromotionAction {
  PROMOTE
  GRADUATE
}

enum PromotionDecision {
  PROMOTE
  DETAIN
  GRADUATE
  EXIT
