enum DocumentReviewStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  NEEDS_INFORMATION
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  OTHER
}

enum NotificationTargetType {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  TRANSPORT_STAFF
  CLASSROOM
  USER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
