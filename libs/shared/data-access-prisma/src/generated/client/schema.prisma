generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LEFT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE_GATEWAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransportAssignmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DocumentEntityType {
  STUDENT
  GUARDIAN
  STAFF
  TEACHER
  SCHOOL
  VEHICLE
  INVOICE
  PAYMENT
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  OTHER
}

enum NotificationTargetType {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  TRANSPORT_STAFF
  CLASSROOM
  USER
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum PromotionBatchStatus {
  DRAFT
  APPLIED
  CANCELLED
}

enum PromotionAction {
  PROMOTE
  GRADUATE
}

enum PromotionDecision {
  PROMOTE
  DETAIN
  GRADUATE
  EXIT
  TRANSFER
}

enum ExitReason {
  TRANSFER
  MIGRATION
  DROPOUT
  EXPELLED
  FEES_UNPAID
  OTHER
}

enum ExitRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Tenant {
  id          String       @id @default(cuid())
  code        String       @unique(map: "uq_tenants_code")
  name        String
  status      TenantStatus @default(ACTIVE)
  timeZone    String       @default("Asia/Kolkata") @map("time_zone")
  countryCode String       @default("IN") @map("country_code")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  schools                     School[]
  academicYears               AcademicYear[]
  terms                       Term[]
  users                       UserTenant[]
  roles                       Role[]
  students                    Student[]
  guardians                   Guardian[]
  staffProfiles               StaffProfile[]
  teacherProfile              TeacherProfile[]
  classRooms                  ClassRoom[]
  subjects                    Subject[]
  enrollments                 Enrollment[]
  feePlans                    FeePlan[]
  feeItems                    FeeItem[]
  studentFeePlan              StudentFeePlan[]
  invoices                    Invoice[]
  invoiceLines                InvoiceLine[]
  payments                    Payment[]
  paymentAlloc                PaymentAllocation[]
  routes                      TransportRoute[]
  stops                       TransportStop[]
  vehicles                    TransportVehicle[]
  transportAsg                StudentTransportAssignment[]
  docs                        Document[]
  auditLogs                   AuditLog[]
  Campus                      Campus[]
  StudentGuardian             StudentGuardian[]
  ClassroomSubject            ClassroomSubject[]
  AttendanceSession           AttendanceSession[]
  AttendanceRecord            AttendanceRecord[]
  timetableEntries            TimetableEntry[]
  teacherAttendance           TeacherAttendance[]
  notifications               Notification[]
  userNotifications           UserNotification[]
  messages                    Message[]
  sessions                    Session[]
  exams                       Exam[]
  examSubjects                ExamSubject[]
  studentAssess               StudentAssessment[]
  homework                    Homework[]
  admissionApplications       AdmissionApplication[]
  promotionBatches            PromotionBatch[]
  promotionMappings           PromotionMapping[]
  promotionOverrides          PromotionStudentOverride[]
  studentExitRequests         StudentExitRequest[]
  userTenantSchoolAssignments UserTenantSchoolAssignment[]

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_tenants_created_by_id_users")
  updatedBy User? @relation("TenantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_tenants_updated_by_id_users")
  deletedBy User? @relation("TenantDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_tenants_deleted_by_id_users")

  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique(map: "uq_users_email")
  phoneE164    String?    @unique(map: "uq_users_phone_e164") @map("phone_e164")
  firstName    String     @map("first_name")
  lastName     String?    @map("last_name")
  status       UserStatus @default(INVITED)
  passwordHash String?    @map("password_hash")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships       UserTenant[]
  staffProfiles     StaffProfile[]
  guardianProfiles  Guardian[]
  uploadedDocuments Document[]
  auditLogs         AuditLog[]
  sessions          Session[]
  notificationsSent Notification[]     @relation("NotificationSender")
  notificationReads UserNotification[]
  messagesSent      Message[]          @relation("MessageSender")
  messagesReceived  Message[]          @relation("MessageRecipient")

  academicYearsCreated               AcademicYear[]               @relation("AcademicYearCreatedBy")
  academicYearsDeleted               AcademicYear[]               @relation("AcademicYearDeletedBy")
  academicYearsUpdated               AcademicYear[]               @relation("AcademicYearUpdatedBy")
  admissionApplicationsCreated       AdmissionApplication[]       @relation("AdmissionApplicationCreatedBy")
  admissionApplicationsDeleted       AdmissionApplication[]       @relation("AdmissionApplicationDeletedBy")
  admissionApplicationsUpdated       AdmissionApplication[]       @relation("AdmissionApplicationUpdatedBy")
  attendanceRecordsCreated           AttendanceRecord[]           @relation("AttendanceRecordCreatedBy")
  attendanceRecordsDeleted           AttendanceRecord[]           @relation("AttendanceRecordDeletedBy")
  attendanceRecordsUpdated           AttendanceRecord[]           @relation("AttendanceRecordUpdatedBy")
  attendanceSessionsCreated          AttendanceSession[]          @relation("AttendanceSessionCreatedBy")
  attendanceSessionsDeleted          AttendanceSession[]          @relation("AttendanceSessionDeletedBy")
  attendanceSessionsUpdated          AttendanceSession[]          @relation("AttendanceSessionUpdatedBy")
  auditLogsCreated                   AuditLog[]                   @relation("AuditLogCreatedBy")
  auditLogsDeleted                   AuditLog[]                   @relation("AuditLogDeletedBy")
  auditLogsUpdated                   AuditLog[]                   @relation("AuditLogUpdatedBy")
  campusesCreated                    Campus[]                     @relation("CampusCreatedBy")
  campusesDeleted                    Campus[]                     @relation("CampusDeletedBy")
  campusesUpdated                    Campus[]                     @relation("CampusUpdatedBy")
  classRoomsCreated                  ClassRoom[]                  @relation("ClassRoomCreatedBy")
  classRoomsDeleted                  ClassRoom[]                  @relation("ClassRoomDeletedBy")
  classroomSubjectsCreated           ClassroomSubject[]           @relation("ClassroomSubjectCreatedBy")
  classroomSubjectsDeleted           ClassroomSubject[]           @relation("ClassroomSubjectDeletedBy")
  classroomSubjectsUpdated           ClassroomSubject[]           @relation("ClassroomSubjectUpdatedBy")
  classRoomsUpdated                  ClassRoom[]                  @relation("ClassRoomUpdatedBy")
  documentsCreated                   Document[]                   @relation("DocumentCreatedBy")
  documentsDeleted                   Document[]                   @relation("DocumentDeletedBy")
  documentsUpdated                   Document[]                   @relation("DocumentUpdatedBy")
  enrollmentsCreated                 Enrollment[]                 @relation("EnrollmentCreatedBy")
  enrollmentsDeleted                 Enrollment[]                 @relation("EnrollmentDeletedBy")
  enrollmentsUpdated                 Enrollment[]                 @relation("EnrollmentUpdatedBy")
  examsCreated                       Exam[]                       @relation("ExamCreatedBy")
  examsDeleted                       Exam[]                       @relation("ExamDeletedBy")
  examSubjectsCreated                ExamSubject[]                @relation("ExamSubjectCreatedBy")
  examSubjectsDeleted                ExamSubject[]                @relation("ExamSubjectDeletedBy")
  examSubjectsUpdated                ExamSubject[]                @relation("ExamSubjectUpdatedBy")
  examsUpdated                       Exam[]                       @relation("ExamUpdatedBy")
  feeItemsCreated                    FeeItem[]                    @relation("FeeItemCreatedBy")
  feeItemsDeleted                    FeeItem[]                    @relation("FeeItemDeletedBy")
  feeItemsUpdated                    FeeItem[]                    @relation("FeeItemUpdatedBy")
  feePlansCreated                    FeePlan[]                    @relation("FeePlanCreatedBy")
  feePlansDeleted                    FeePlan[]                    @relation("FeePlanDeletedBy")
  feePlansUpdated                    FeePlan[]                    @relation("FeePlanUpdatedBy")
  guardiansCreated                   Guardian[]                   @relation("GuardianCreatedBy")
  guardiansDeleted                   Guardian[]                   @relation("GuardianDeletedBy")
  guardiansUpdated                   Guardian[]                   @relation("GuardianUpdatedBy")
  homeworksCreated                   Homework[]                   @relation("HomeworkCreatedBy")
  homeworksDeleted                   Homework[]                   @relation("HomeworkDeletedBy")
  homeworksUpdated                   Homework[]                   @relation("HomeworkUpdatedBy")
  invoiceLinesCreated                InvoiceLine[]                @relation("InvoiceLineCreatedBy")
  invoiceLinesDeleted                InvoiceLine[]                @relation("InvoiceLineDeletedBy")
  invoiceLinesUpdated                InvoiceLine[]                @relation("InvoiceLineUpdatedBy")
  invoicesCreated                    Invoice[]                    @relation("InvoiceCreatedBy")
  invoicesDeleted                    Invoice[]                    @relation("InvoiceDeletedBy")
  invoicesUpdated                    Invoice[]                    @relation("InvoiceUpdatedBy")
  messagesCreated                    Message[]                    @relation("MessageCreatedBy")
  messagesDeleted                    Message[]                    @relation("MessageDeletedBy")
  messagesUpdated                    Message[]                    @relation("MessageUpdatedBy")
  notificationsCreated               Notification[]               @relation("NotificationCreatedBy")
  notificationsDeleted               Notification[]               @relation("NotificationDeletedBy")
  notificationsUpdated               Notification[]               @relation("NotificationUpdatedBy")
  paymentAllocationsCreated          PaymentAllocation[]          @relation("PaymentAllocationCreatedBy")
  paymentAllocationsDeleted          PaymentAllocation[]          @relation("PaymentAllocationDeletedBy")
  paymentAllocationsUpdated          PaymentAllocation[]          @relation("PaymentAllocationUpdatedBy")
  paymentsCreated                    Payment[]                    @relation("PaymentCreatedBy")
  paymentsDeleted                    Payment[]                    @relation("PaymentDeletedBy")
  paymentsUpdated                    Payment[]                    @relation("PaymentUpdatedBy")
  permissionsCreated                 Permission[]                 @relation("PermissionCreatedBy")
  permissionsDeleted                 Permission[]                 @relation("PermissionDeletedBy")
  permissionsUpdated                 Permission[]                 @relation("PermissionUpdatedBy")
  rolePermissionsCreated             RolePermission[]             @relation("RolePermissionCreatedBy")
  rolePermissionsDeleted             RolePermission[]             @relation("RolePermissionDeletedBy")
  rolePermissionsUpdated             RolePermission[]             @relation("RolePermissionUpdatedBy")
  rolesCreated                       Role[]                       @relation("RoleCreatedBy")
  rolesDeleted                       Role[]                       @relation("RoleDeletedBy")
  rolesUpdated                       Role[]                       @relation("RoleUpdatedBy")
  schoolsCreated                     School[]                     @relation("SchoolCreatedBy")
  schoolsDeleted                     School[]                     @relation("SchoolDeletedBy")
  schoolsUpdated                     School[]                     @relation("SchoolUpdatedBy")
  sessionsCreated                    Session[]                    @relation("SessionCreatedBy")
  sessionsDeleted                    Session[]                    @relation("SessionDeletedBy")
  sessionsUpdated                    Session[]                    @relation("SessionUpdatedBy")
  staffProfilesCreated               StaffProfile[]               @relation("StaffProfileCreatedBy")
  staffProfilesDeleted               StaffProfile[]               @relation("StaffProfileDeletedBy")
  staffProfilesUpdated               StaffProfile[]               @relation("StaffProfileUpdatedBy")
  studentAssessmentsCreated          StudentAssessment[]          @relation("StudentAssessmentCreatedBy")
  studentAssessmentsDeleted          StudentAssessment[]          @relation("StudentAssessmentDeletedBy")
  studentAssessmentsUpdated          StudentAssessment[]          @relation("StudentAssessmentUpdatedBy")
  studentFeePlansCreated             StudentFeePlan[]             @relation("StudentFeePlanCreatedBy")
  studentFeePlansDeleted             StudentFeePlan[]             @relation("StudentFeePlanDeletedBy")
  studentFeePlansUpdated             StudentFeePlan[]             @relation("StudentFeePlanUpdatedBy")
  studentGuardiansCreated            StudentGuardian[]            @relation("StudentGuardianCreatedBy")
  studentGuardiansDeleted            StudentGuardian[]            @relation("StudentGuardianDeletedBy")
  studentGuardiansUpdated            StudentGuardian[]            @relation("StudentGuardianUpdatedBy")
  studentsCreated                    Student[]                    @relation("StudentCreatedBy")
  studentsDeleted                    Student[]                    @relation("StudentDeletedBy")
  studentsUpdated                    Student[]                    @relation("StudentUpdatedBy")
  studentTransportAssignmentsCreated StudentTransportAssignment[] @relation("StudentTransportAssignmentCreatedBy")
  studentTransportAssignmentsDeleted StudentTransportAssignment[] @relation("StudentTransportAssignmentDeletedBy")
  studentTransportAssignmentsUpdated StudentTransportAssignment[] @relation("StudentTransportAssignmentUpdatedBy")
  subjectsCreated                    Subject[]                    @relation("SubjectCreatedBy")
  subjectsDeleted                    Subject[]                    @relation("SubjectDeletedBy")
  subjectsUpdated                    Subject[]                    @relation("SubjectUpdatedBy")
  teacherAttendancesCreated          TeacherAttendance[]          @relation("TeacherAttendanceCreatedBy")
  teacherAttendancesDeleted          TeacherAttendance[]          @relation("TeacherAttendanceDeletedBy")
  teacherAttendancesUpdated          TeacherAttendance[]          @relation("TeacherAttendanceUpdatedBy")
  teacherProfilesCreated             TeacherProfile[]             @relation("TeacherProfileCreatedBy")
  teacherProfilesDeleted             TeacherProfile[]             @relation("TeacherProfileDeletedBy")
  teacherProfilesUpdated             TeacherProfile[]             @relation("TeacherProfileUpdatedBy")
  tenantsCreated                     Tenant[]                     @relation("TenantCreatedBy")
  tenantsDeleted                     Tenant[]                     @relation("TenantDeletedBy")
  tenantsUpdated                     Tenant[]                     @relation("TenantUpdatedBy")
  termsCreated                       Term[]                       @relation("TermCreatedBy")
  termsDeleted                       Term[]                       @relation("TermDeletedBy")
  termsUpdated                       Term[]                       @relation("TermUpdatedBy")
  timetableEntrysCreated             TimetableEntry[]             @relation("TimetableEntryCreatedBy")
  timetableEntrysDeleted             TimetableEntry[]             @relation("TimetableEntryDeletedBy")
  timetableEntrysUpdated             TimetableEntry[]             @relation("TimetableEntryUpdatedBy")
  transportRoutesCreated             TransportRoute[]             @relation("TransportRouteCreatedBy")
  transportRoutesDeleted             TransportRoute[]             @relation("TransportRouteDeletedBy")
  transportRoutesUpdated             TransportRoute[]             @relation("TransportRouteUpdatedBy")
  transportStopsCreated              TransportStop[]              @relation("TransportStopCreatedBy")
  transportStopsDeleted              TransportStop[]              @relation("TransportStopDeletedBy")
  transportStopsUpdated              TransportStop[]              @relation("TransportStopUpdatedBy")
  transportVehiclesCreated           TransportVehicle[]           @relation("TransportVehicleCreatedBy")
  transportVehiclesDeleted           TransportVehicle[]           @relation("TransportVehicleDeletedBy")
  transportVehiclesUpdated           TransportVehicle[]           @relation("TransportVehicleUpdatedBy")
  userNotificationsCreated           UserNotification[]           @relation("UserNotificationCreatedBy")
  userNotificationsDeleted           UserNotification[]           @relation("UserNotificationDeletedBy")
  userNotificationsUpdated           UserNotification[]           @relation("UserNotificationUpdatedBy")
  userRoleAssignmentsCreated         UserRoleAssignment[]         @relation("UserRoleAssignmentCreatedBy")
  userRoleAssignmentsDeleted         UserRoleAssignment[]         @relation("UserRoleAssignmentDeletedBy")
  userRoleAssignmentsUpdated         UserRoleAssignment[]         @relation("UserRoleAssignmentUpdatedBy")
  usersCreated                       User[]                       @relation("UserCreatedBy")
  usersDeleted                       User[]                       @relation("UserDeletedBy")
  usersUpdated                       User[]                       @relation("UserUpdatedBy")
  userTenantsCreated                 UserTenant[]                 @relation("UserTenantCreatedBy")
  userTenantsDeleted                 UserTenant[]                 @relation("UserTenantDeletedBy")
  userTenantsUpdated                 UserTenant[]                 @relation("UserTenantUpdatedBy")
  userTenantSchoolAssignmentsCreated UserTenantSchoolAssignment[] @relation("UserTenantSchoolAssignmentCreatedBy")
  userTenantSchoolAssignmentsDeleted UserTenantSchoolAssignment[] @relation("UserTenantSchoolAssignmentDeletedBy")
  userTenantSchoolAssignmentsUpdated UserTenantSchoolAssignment[] @relation("UserTenantSchoolAssignmentUpdatedBy")
  promotionBatchesCreated            PromotionBatch[]             @relation("PromotionBatchCreatedBy")
  promotionBatchesDeleted            PromotionBatch[]             @relation("PromotionBatchDeletedBy")
  promotionBatchesUpdated            PromotionBatch[]             @relation("PromotionBatchUpdatedBy")
  promotionMappingsCreated           PromotionMapping[]           @relation("PromotionMappingCreatedBy")
  promotionMappingsDeleted           PromotionMapping[]           @relation("PromotionMappingDeletedBy")
  promotionMappingsUpdated           PromotionMapping[]           @relation("PromotionMappingUpdatedBy")
  promotionOverridesCreated          PromotionStudentOverride[]   @relation("PromotionStudentOverrideCreatedBy")
  promotionOverridesDeleted          PromotionStudentOverride[]   @relation("PromotionStudentOverrideDeletedBy")
  promotionOverridesUpdated          PromotionStudentOverride[]   @relation("PromotionStudentOverrideUpdatedBy")
  studentExitRequestsCreated         StudentExitRequest[]         @relation("StudentExitRequestCreatedBy")
  studentExitRequestsDeleted         StudentExitRequest[]         @relation("StudentExitRequestDeletedBy")
  studentExitRequestsUpdated         StudentExitRequest[]         @relation("StudentExitRequestUpdatedBy")
  studentExitRequestsRequested       StudentExitRequest[]         @relation("StudentExitRequestRequestedBy")
  studentExitRequestsDecided         StudentExitRequest[]         @relation("StudentExitRequestDecidedBy")

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_users_created_by_id_users")
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_users_updated_by_id_users")
  deletedBy User? @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_users_deleted_by_id_users")

  @@index([status], map: "idx_users_status")
  @@map("users")
}

model UserTenant {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  userId     String           @map("user_id")
  status     MembershipStatus @default(INVITED)
  joinedAt   DateTime?        @map("joined_at")
  lastSeenAt DateTime?        @map("last_seen_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments   UserRoleAssignment[]
  schoolAssignments UserTenantSchoolAssignment[]

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("UserTenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_user_tenants_created_by_id_users")
  updatedBy User? @relation("UserTenantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_user_tenants_updated_by_id_users")
  deletedBy User? @relation("UserTenantDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_user_tenants_deleted_by_id_users")

  @@unique([tenantId, userId], map: "uq_user_tenants_tenant_user")
  @@index([userId], map: "idx_user_tenants_user_id")
  @@index([tenantId, status], map: "idx_user_tenants_tenant_status")
  @@map("user_tenants")
}

model UserTenantSchoolAssignment {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  userTenantId         String   @map("user_tenant_id")
  schoolId             String   @map("school_id")
  canManageAllCampuses Boolean  @default(true) @map("can_manage_all_campuses")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("UserTenantSchoolAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_user_tenant_school_assignments_created_by_id_users")
  updatedBy User? @relation("UserTenantSchoolAssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_user_tenant_school_assignments_updated_by_id_users")
  deletedBy User? @relation("UserTenantSchoolAssignmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_user_tenant_school_assignments_deleted_by_id_users")

  @@unique([userTenantId, schoolId], map: "uq_user_tenant_school_assignments_user_tenant_school")
  @@index([tenantId, schoolId], map: "idx_user_tenant_school_assignments_tenant_school")
  @@index([tenantId, userTenantId], map: "idx_user_tenant_school_assignments_tenant_user_tenant")
  @@map("user_tenant_school_assignments")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_roles_created_by_id_users")
  updatedBy User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_roles_updated_by_id_users")
  deletedBy User? @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_roles_deleted_by_id_users")

  @@unique([tenantId, key], map: "uq_roles_tenant_key")
  @@index([tenantId], map: "idx_roles_tenant_id")
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique(map: "uq_permissions_key")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_permissions_created_by_id_users")
  updatedBy User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_permissions_updated_by_id_users")
  deletedBy User? @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_permissions_deleted_by_id_users")

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("RolePermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_role_permissions_created_by_id_users")
  updatedBy User? @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_role_permissions_updated_by_id_users")
  deletedBy User? @relation("RolePermissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_role_permissions_deleted_by_id_users")

  @@unique([roleId, permissionId], map: "uq_role_permissions_role_permission")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String   @id @default(cuid())
  userTenantId String   @map("user_tenant_id")
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at")

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

