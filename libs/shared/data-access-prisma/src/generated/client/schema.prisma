  deletedBy User? @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_messages_deleted_by_id_users")

  @@index([tenantId, schoolId, sentAt], map: "idx_messages_tenant_school_sent_at")
  @@index([senderId, recipientId], map: "idx_messages_sender_recipient")
  @@map("messages")
}

model Session {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  token      String    @unique(map: "uq_sessions_token")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_sessions_created_by_id_users")
  updatedBy User? @relation("SessionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_sessions_updated_by_id_users")
  deletedBy User? @relation("SessionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_sessions_deleted_by_id_users")

  @@index([userId, expiresAt], map: "idx_sessions_user_expires_at")
  @@index([tenantId, userId], map: "idx_sessions_tenant_user")
  @@map("sessions")
}

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  actorUserId String?     @map("actor_user_id")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id")
  message     String?
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy User? @relation("AuditLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_audit_logs_created_by_id_users")
  updatedBy User? @relation("AuditLogUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_audit_logs_updated_by_id_users")
  deletedBy User? @relation("AuditLogDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, map: "fk_audit_logs_deleted_by_id_users")

  @@index([tenantId, createdAt], map: "idx_audit_logs_tenant_created_at")
  @@index([tenantId, entityType, entityId], map: "idx_audit_logs_entity_lookup")
  @@map("audit_logs")
}
