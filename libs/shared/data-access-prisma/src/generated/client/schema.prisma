  deletedById String?   @map("deleted_by_id")

  @@index([tenantId, createdAt], map: "idx_audit_logs_tenant_created_at")
  @@index([tenantId, entityType, entityId], map: "idx_audit_logs_entity_lookup")
  @@map("audit_logs")
}
