{
  "name": "@gps/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "projects": [
              "@gps/data-access-prisma"
            ],
            "target": "generate",
            "params": "ignore"
          }
        ],
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@gps/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@gps/api:build:development"
          },
          "production": {
            "buildTarget": "@gps/api:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@gps/data-access-db": "workspace:*",
    "@gps/feature-academics": "workspace:*",
    "@gps/feature-attendance": "workspace:*",
    "@gps/feature-billing": "workspace:*",
    "@gps/feature-communications": "workspace:*",
    "@gps/feature-documents": "workspace:*",
    "@gps/feature-auth": "workspace:*",
    "@gps/feature-guardians": "workspace:*",
    "@gps/feature-rbac": "workspace:*",
    "@gps/feature-schools": "workspace:*",
    "@gps/feature-staff": "workspace:*",
    "@gps/feature-students": "workspace:*",
    "@gps/feature-tenants": "workspace:*",
    "@gps/feature-timetable": "workspace:*",
    "@gps/feature-transport": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "nestjs-pino": "^4.4.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
